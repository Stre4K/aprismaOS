# =========================
# AprismaOS user programs
# =========================
#
# Every programs/<name>.c becomes a statically linked ELF executable. All of
# them are embedded into user_programs.o (one table of name/start/end plus
# the files themselves), which the kernel links: `run <name>` starts one.
# Only x86_64 has user mode so far; on other architectures this does nothing.

HOSTARCH ?= i386

SRC_DIR := $(ROOTDIR)/src/user
OBJ_DIR := $(OBJ_DIR)/user
SYSROOT := $(SYSROOT)

YELLOW := \033[0;33m
GREEN  := \033[0;32m
CYAN   := \033[0;36m
RESET  := \033[0m

.PHONY: all install install-headers clean

ifeq ($(HOSTARCH),x86_64)

PROGRAMS := $(sort $(basename $(notdir $(wildcard $(SRC_DIR)/programs/*.c))))

# No SSE: the kernel does not save SSE/FPU registers between processes yet
CFLAGS  := -O2 -g -std=gnu11 -ffreestanding -fno-pie -mgeneral-regs-only \
           -Wall -Wextra -Werror -I$(SRC_DIR)/lib -I$(ROOTDIR)/src/kernel/include
LDFLAGS := -nostdlib -static -no-pie -z max-page-size=0x1000 -T $(SRC_DIR)/user.ld

LIB_OBJS := $(OBJ_DIR)/lib/start.o $(OBJ_DIR)/lib/ulib.o
ELFS     := $(patsubst %,$(OBJ_DIR)/bin/%.elf,$(PROGRAMS))
TABLE    := $(OBJ_DIR)/user_programs.o

all: $(TABLE)

$(OBJ_DIR)/lib/%.o: $(SRC_DIR)/lib/%.c
	@mkdir -p $(dir $@)
	@echo "$(CYAN)[user] Compiling $(notdir $<)$(RESET)"
	@$(CC) $(CFLAGS) -MD -MP -c $< -o $@

$(OBJ_DIR)/lib/%.o: $(SRC_DIR)/lib/%.S
	@mkdir -p $(dir $@)
	@echo "$(CYAN)[user] Compiling $(notdir $<)$(RESET)"
	@$(CC) $(CFLAGS) -c $< -o $@

$(OBJ_DIR)/programs/%.o: $(SRC_DIR)/programs/%.c
	@mkdir -p $(dir $@)
	@echo "$(CYAN)[user] Compiling $(notdir $<)$(RESET)"
	@$(CC) $(CFLAGS) -MD -MP -c $< -o $@

$(OBJ_DIR)/bin/%.elf: $(OBJ_DIR)/programs/%.o $(LIB_OBJS) $(SRC_DIR)/user.ld
	@mkdir -p $(dir $@)
	@echo "$(CYAN)[user] Linking $(notdir $@)$(RESET)"
	@$(CC) $(LDFLAGS) -o $@ $(LIB_OBJS) $< -lgcc

# Table of {name, start, end} followed by the program files themselves
$(OBJ_DIR)/user_programs.S: $(ELFS) $(SRC_DIR)/Makefile
	@mkdir -p $(dir $@)
	@{ \
	  echo '// Generated by src/user/Makefile: the built-in user programs'; \
	  echo '.section .rodata'; \
	  echo '.balign 8'; \
	  echo '.global user_programs'; \
	  echo 'user_programs:'; \
	  for p in $(PROGRAMS); do echo "    .quad name_$$p, start_$$p, end_$$p"; done; \
	  echo '    .quad 0, 0, 0'; \
	  for p in $(PROGRAMS); do \
	    echo "name_$$p: .asciz \"$$p\""; \
	    echo '.balign 16'; \
	    echo "start_$$p: .incbin \"$(OBJ_DIR)/bin/$$p.elf\""; \
	    echo "end_$$p:"; \
	  done; \
	} > $@

$(TABLE): $(OBJ_DIR)/user_programs.S
	@echo "$(GREEN)[user] Embedding $(words $(PROGRAMS)) programs$(RESET)"
	@$(CC) -c $< -o $@

install: $(TABLE)
	@mkdir -p $(SYSROOT)/lib
	@cp $(TABLE) $(SYSROOT)/lib/

-include $(wildcard $(OBJ_DIR)/lib/*.d $(OBJ_DIR)/programs/*.d)

else

all install:
	@echo "$(YELLOW)[user] No user mode on $(HOSTARCH) yet, skipping$(RESET)"

endif

install-headers:

clean:
	rm -rf $(OBJ_DIR)
