# x86_64: higher-half kernel at 0xFFFFFFFF80000000 (-mcmodel=kernel).
# The kernel does not save SSE/FPU state on interrupts, so keep the compiler
# to general purpose registers. No red zone: interrupts write below RSP.
KERNEL_ARCH_CFLAGS=-mcmodel=kernel -mno-red-zone -mgeneral-regs-only -fno-asynchronous-unwind-tables
KERNEL_ARCH_CPPFLAGS=-DCONFIG_SCHED
KERNEL_ARCH_LDFLAGS=-z max-page-size=0x1000
KERNEL_ARCH_LIBS=

# Code shared with i386
KERNEL_ARCH_DIRS=arch/x86
