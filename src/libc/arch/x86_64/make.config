ARCH_CFLAGS=
ARCH_CPPFLAGS=

# libk is linked into the higher-half kernel, so it needs the same code model.
# The kernel does not save SSE/FPU state, so libk must not use those registers.
KERNEL_ARCH_CFLAGS=-mcmodel=kernel -mno-red-zone -mgeneral-regs-only
KERNEL_ARCH_CPPFLAGS=-DLIBK_NO_FLOAT

# Floating point code cannot be built without SSE on x86_64
LIBK_EXCLUDE=\
math/ceil.c \
math/exp.c \
math/fabs.c \
math/floor.c \
math/fmod.c \
math/log.c \
math/pow.c \
math/round.c \
math/sqrt.c
